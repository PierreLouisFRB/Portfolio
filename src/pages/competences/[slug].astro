---
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import { getCompetences, ANNEES } from '../../lib/data';

export async function getStaticPaths() {
  const competences = await getCompetences();
  return competences.map(({ slug, entry }) => ({ params: { slug }, props: { entry } }));
}
const { entry } = Astro.props;
const annee = ANNEES.find((a) => a.id === entry.annee);

type Bloc = (typeof entry.acs)[number]['blocs'][number];
type Image = Extract<Bloc, { discriminant: 'image' }>['value'];
// Regroupe les images qui se suivent en une galerie de miniatures.
function grouper(blocs: Bloc[]) {
  const out: ({ galerie: Image[] } | { bloc: Bloc })[] = [];
  for (const b of blocs) {
    if (b.discriminant === 'image') {
      if (!b.value.image) continue;
      const dernier = out.at(-1);
      if (dernier && 'galerie' in dernier) dernier.galerie.push(b.value);
      else out.push({ galerie: [b.value] });
    } else out.push({ bloc: b });
  }
  return out;
}
---
<Base titre={`${entry.code} ${entry.titre}`} description={entry.description}>
  <section class="section">
    <div class="conteneur" style="max-width:860px">
      <a class="retour" href={`/competences#${entry.annee}`}>← Retour aux compétences</a>
      <div style="display:flex;gap:14px;align-items:center;margin-top:24px">
        <span class="pastille"><Icone nom={entry.icone} /></span>
        <span class="etiquette">{annee?.label} · {entry.code}</span>
      </div>
      <h1 class="titre-section titre-comp" style="margin-bottom:12px">{entry.titre}{entry.sousTitre && <em> {entry.sousTitre}</em>}</h1>
      <p class="muted" style="font-size:1.1rem">{entry.description}</p>
      {entry.presentation && <p style="white-space:pre-line">{entry.presentation}</p>}

      <h2 style="margin-top:40px;font-size:1.3rem">Apprentissages critiques</h2>
      {entry.acs.map((ac) => (
        <details class="carte ac" open>
          <summary><span class="ac__code">{ac.code}</span><span class="ac__titre">{ac.titre}</span></summary>
          {ac.description && <p class="muted" style="margin:10px 0 0">{ac.description}</p>}
          <div class="blocs">
            {ac.blocs.length === 0 && <p class="muted" style="margin:0">Contenu à venir.</p>}
            {grouper(ac.blocs).map((item) => {
              if ('galerie' in item) return (
                <div class="galerie">
                  {item.galerie.map((img) => (
                    <button type="button" class="vignette" data-src={img.image} data-legende={img.legende}>
                      <img src={img.image} alt={img.legende || ac.titre} loading="lazy" />
                    </button>
                  ))}
                </div>
              );
              const b = item.bloc;
              if (b.discriminant === 'texte') return (
                <div class:list={['bloc-texte', { 'mise-en-avant': b.value.miseEnAvant }]}>{b.value.titre && <h4>{b.value.titre}</h4>}<p>{b.value.texte}</p></div>
              );
              if (b.discriminant === 'fichier' && b.value.fichier) return (
                <a class="bloc-fichier" href={b.value.fichier} download={b.value.nom + (b.value.fichier.match(/\.[a-z0-9]+$/i)?.[0] ?? '')}><Icone nom="file" />{b.value.nom}</a>
              );
              if (b.discriminant === 'lien' && b.value.url) return (
                <a class="bloc-lien" href={b.value.url} target="_blank" rel="noopener"><Icone nom="link" />{b.value.texte}</a>
              );
              return null;
            })}
          </div>
        </details>
      ))}
    </div>
  </section>
  <dialog class="visionneuse" id="visionneuse">
    <form method="dialog"><button class="fermer" aria-label="Fermer">×</button></form>
    <img alt="" />
    <p></p>
  </dialog>
  <script>
    const v = document.getElementById('visionneuse') as HTMLDialogElement;
    document.querySelectorAll<HTMLButtonElement>('.vignette').forEach((b) =>
      b.addEventListener('click', () => {
        v.querySelector('img')!.src = b.dataset.src!;
        v.querySelector('p')!.textContent = b.dataset.legende ?? '';
        v.showModal();
      })
    );
    v.addEventListener('click', (e) => { if (e.target === v) v.close(); });
  </script>
</Base>
